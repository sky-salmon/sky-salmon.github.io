rules_version = '2';
// candle·kit Firestore rules (paste into Firebase console → Firestore Database → Rules).
//   cards/{uid}     one signed-in user's own card (JSON string in `data`): only that user can read or write it.
//   shares/{uid}    older share links: read-only now; share links carry the card in the address instead.
//   config/admins   Google accounts allowed into admin.html ({uids, labels}); admins add and remove each other there.
//   config/github   the GitHub token and repository admin.html saves to; readable by admins only.
//   requests/{uid}  an account asking to become an admin; admins see and approve or dismiss it.
//   access/{uid}    every signed-in account that asked for a restricted feature: pending until an admin approves it
//                   and ticks the features it may use (perms: {feature: true}).
//   config/features which restricted features are open to everyone after all ({public: {feature: true}}).
//   gated/{feature} the data a restricted feature needs (e.g. the value model); readable by admins, by accounts
//                   approved for that feature, or by anyone when the feature is public.
//   feedback/{id}   messages from the site's feedback form: anyone can send one, only admins read them.
//   valueSuggestions/{id}  "this account is worth X" from people who can use the 估價 tab, with what the estimate saw;
//                   only admins read them (to refit the value model).
// Nothing outside requests/, access/, feedback/ and valueSuggestions/ can be listed (admins only), so shared cards are only reachable
// through their link.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedInAs(uid) { return request.auth != null && request.auth.uid == uid; }
    // Always an admin, even if config/admins is emptied or deleted (so the owner can't lock themselves out).
    // The owner's account in the sky-salmon project (set through admin.html's first-time setup, 2026-11-19).
    function rootAdmins() { return ['P6KFeJL3GQPqSdRTw3ziAr4dNWz1']; }
    function isAdmin() {
      let admins = /databases/$(database)/documents/config/admins;
      return request.auth != null && (request.auth.uid in rootAdmins()
        || (exists(admins) && request.auth.uid in get(admins).data.uids));
    }
    // an account an admin approved for this feature
    function hasPerm(f) {
      let a = /databases/$(database)/documents/access/$(request.auth.uid);
      return request.auth != null && exists(a) && get(a).data.status == 'approved'
        && f in get(a).data.perms && get(a).data.perms[f] == true;
    }
    // a restricted feature the admins opened to everyone
    function isPublic(f) {
      let c = /databases/$(database)/documents/config/features;
      return exists(c) && f in get(c).data.public && get(c).data.public[f] == true;
    }
    function validCard(keys) {
      let d = request.resource.data;
      return d.keys().hasOnly(keys) && d.v == 1 && d.data is string && d.data.size() < 1000000
        && d.updatedAt == request.time;
    }

    match /cards/{uid} {
      allow get, delete: if signedInAs(uid);
      allow create, update: if signedInAs(uid) && validCard(['v', 'data', 'updatedAt']);
    }

    // older share links (card?s=<uid>): readable until their owner signs in again (the page then deletes them).
    // New share links carry the card in the address and store nothing.
    match /shares/{uid} {
      allow get: if true;
      allow delete: if signedInAs(uid);
    }

    match /config/admins {
      allow get: if isAdmin();
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['uids', 'labels', 'updatedAt'])
        && request.resource.data.uids is list && request.resource.data.uids.size() <= 50
        && request.resource.data.labels is map && request.resource.data.updatedAt == request.time;
    }

    match /config/github {
      allow get, delete: if isAdmin();
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['token', 'repo', 'updatedAt'])
        && request.resource.data.token is string && request.resource.data.token.size() < 400
        && request.resource.data.repo is string && request.resource.data.repo.matches('^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$')
        && request.resource.data.updatedAt == request.time;
    }

    match /requests/{uid} {
      allow get: if signedInAs(uid) || isAdmin();
      allow list, delete: if isAdmin();
      allow create, update: if signedInAs(uid)
        && request.resource.data.keys().hasOnly(['label', 'createdAt'])
        && request.resource.data.label is string && request.resource.data.label.size() < 200
        && request.resource.data.label == request.auth.token.email   // shown to the admin who approves: can't be made up
        && request.resource.data.createdAt == request.time;
    }

    match /access/{uid} {
      allow get: if signedInAs(uid) || isAdmin();
      allow list, delete: if isAdmin();
      // the account asks: always starts pending with no features, labelled with its own verified email
      allow create: if signedInAs(uid)
        && request.resource.data.keys().hasOnly(['label', 'status', 'perms', 'createdAt', 'updatedAt'])
        && request.resource.data.label == request.auth.token.email
        && request.resource.data.status == 'pending' && request.resource.data.perms == {}
        && request.resource.data.createdAt == request.time && request.resource.data.updatedAt == request.time;
      // only admins decide; the label and the request date stay as the account sent them
      allow update: if isAdmin()
        && request.resource.data.keys().hasOnly(['label', 'status', 'perms', 'note', 'createdAt', 'updatedAt'])
        && request.resource.data.label == resource.data.label && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.status in ['pending', 'approved', 'denied'] && request.resource.data.perms is map
        && request.resource.data.updatedAt == request.time;
    }

    match /config/features {
      allow get: if true;
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['public', 'updatedAt'])
        && request.resource.data.public is map && request.resource.data.updatedAt == request.time;
    }

    match /gated/{feature} {
      allow get: if isAdmin() || hasPerm(feature) || isPublic(feature);
      allow delete: if isAdmin();
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['data', 'version', 'updatedAt'])
        && request.resource.data.data is string && request.resource.data.data.size() < 1000000
        && request.resource.data.version is string && request.resource.data.version.size() < 40
        && request.resource.data.updatedAt == request.time;
    }

    match /feedback/{id} {
      // anyone can send one message; nothing in it can claim to be someone else
      allow create: if request.resource.data.keys().hasOnly(['kind', 'msg', 'page', 'contact', 'lang', 'status', 'createdAt'])
        && request.resource.data.kind in ['bug', 'data', 'idea', 'other']
        && request.resource.data.msg is string && request.resource.data.msg.size() > 0 && request.resource.data.msg.size() <= 2000
        && request.resource.data.page is string && request.resource.data.page.size() <= 300
        && request.resource.data.contact is string && request.resource.data.contact.size() <= 200
        && request.resource.data.lang is string && request.resource.data.lang.size() <= 20
        && request.resource.data.status == 'new' && request.resource.data.createdAt == request.time;
      allow get, list, delete: if isAdmin();
      allow update: if isAdmin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && request.resource.data.status in ['new', 'done'];
    }

    match /valueSuggestions/{id} {
      // whoever may use the estimate can say what they think the account is worth; the uid can't be someone else's
      allow create: if (isAdmin() || hasPerm('value') || isPublic('value')) && validSuggestion(request.resource.data);
      allow get, list, delete: if isAdmin();
      allow update: if isAdmin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && request.resource.data.status in ['new', 'done'];
    }
    function validSuggestion(d) {
      return d.keys().hasOnly(['model', 'cur', 'price', 'priceTwd', 'est', 'source', 'note', 'acct', 'uid', 'lang', 'status', 'createdAt'])
        && d.model is string && d.model.size() <= 20 && d.cur in ['TWD', 'CNY', 'MYR', 'HKD']
        && d.price is number && d.price > 0 && d.price < 10000000 && d.priceTwd is number
        && d.est is map && d.est.keys().hasOnly(['center', 'low', 'high', 'quick', 'patient'])
        && d.source in ['sold', 'ask', 'own', 'feel'] && d.note is string && d.note.size() <= 500
        && d.acct is map && d.acct.seasons is list && d.acct.seasons.size() <= 80 && d.acct.items is list && d.acct.items.size() <= 3000
        && d.acct.ults is list && d.acct.ults.size() <= 200 && d.acct.packs is list && d.acct.packs.size() <= 600
        && ((request.auth == null && d.uid == '') || (request.auth != null && d.uid == request.auth.uid))
        && d.lang is string && d.lang.size() <= 20 && d.status == 'new' && d.createdAt == request.time;
    }

    // admin.html before config/: one GitHub token per admin account. Read once to move it into config/github.
    match /admin/{uid} {
      allow get, delete: if signedInAs(uid) && isAdmin();
    }
  }
}
