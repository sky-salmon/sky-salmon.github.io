rules_version = '2';
// candle·kit (card.html) cloud data.
//   cards/{uid}   one signed-in user's own card (JSON string in `data`): only that user can read or write it.
//   shares/{uid}  the card that user shared: anyone with the link can read it, only its owner can write it.
//                 The id is the owner's uid, so every Google account has at most one shared card (no spam).
// Nothing can be listed, so shared cards are only reachable through their link.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedInAs(uid) { return request.auth != null && request.auth.uid == uid; }
    function validCard(keys) {
      let d = request.resource.data;
      return d.keys().hasOnly(keys) && d.v == 1 && d.data is string && d.data.size() < 1000000
        && d.updatedAt == request.time;
    }

    match /cards/{uid} {
      allow get, delete: if signedInAs(uid);
      allow create, update: if signedInAs(uid) && validCard(['v', 'data', 'updatedAt']);
    }

    match /shares/{uid} {
      allow get: if true;
      allow create, update: if signedInAs(uid) && validCard(['v', 'data', 'updatedAt']);
      allow delete: if signedInAs(uid);
    }
  }
}
